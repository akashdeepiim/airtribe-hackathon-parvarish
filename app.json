{
  "expo": {
    "name": "Parvarish",
    "slug": "parvarish",
    "scheme": "parvarish",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.parvarish.app"
    },
    "android": {
      "package": "in.parvarish.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "Parvarish",
      "favicon": "./public/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your child's private profile.",
          "microphonePermission": false,
          "cameraPermission": false
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      "expo-asset"
    ]
  }
}
