{
  "name": "parvarish",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "supabase test db",
    "test:api": "node scripts/test-local-api.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "lint:content": "node scripts/lint-content.mjs",
    "check": "npm run typecheck && npm test && npm run lint:content",
    "export:web": "expo export --platform web",
    "build:brand": "node scripts/build-brand.mjs",
    "build:web": "node scripts/prepare-web.mjs && expo export --platform web && node scripts/finish-web.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.0.0",
    "@tanstack/react-query": "^5.0.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "supabase": "^2.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  }
}
