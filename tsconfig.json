{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "types": ["node", "react", "react-native"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "api/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": ["supabase/functions", "node_modules"]
}
